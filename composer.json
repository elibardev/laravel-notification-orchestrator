{
    "name": "elibardev/laravel-notification-orchestrator",
    "description": "Modular notification orchestration for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "google/auth": "^1.48",
        "illuminate/broadcasting": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/notifications": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0",
        "php-mqtt/client": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Elibardev\\NotificationOrchestrator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elibardev\\NotificationOrchestrator\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elibardev\\NotificationOrchestrator\\NotificationOrchestratorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "check": [
            "@composer validate --strict",
            "@test",
            "@analyse",
            "@format:check"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
